// Copy this file to Config/Secrets.xcconfig and fill in real values.
// Config/Secrets.xcconfig is git-ignored — never commit credentials.
//
// Values come from the Google Cloud console:
//   APIs & Services > Credentials > OAuth 2.0 Client IDs
//
// Prefer a "Desktop app" client, which uses PKCE and needs no secret.
// In that case leave GOOGLE_CLIENT_SECRET empty.

GOOGLE_CLIENT_ID = your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET =
